# Neon/PostgreSQL connection string. Keep the real value only in .env.local.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Comma-separated list of origins allowed to POST to public forms.
# Requests from any other origin (or with no Origin header) are rejected.
ALLOWED_ORIGINS="https://chefharrizona.co.ke"

# ─── Admin authentication ───────────────────────────────────────────────────
# Set these values in Vercel (do not prefix them with NEXT_PUBLIC_).
ADMIN_EMAIL="hacker.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
# Generate a long random value, for example: `openssl rand -base64 32`
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"

# ─── AI reply assistant (admin panel) ────────────────────────────────────────
# OpenAI-compatible chat completions API. Leave unset to use template replies.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="-4o-mini"
# Optional: auto-email the AI reply to the client the moment they submit.
# Requires a free resend.com account and a verified sender domain.
RESEND_API_KEY=""
RESEND_FROM="Chef Harrizona <.co.ke>"

# ─── Cloudinary (admin video uploads) ────────────────────────────────────────
# Video files upload directly from the browser to Cloudinary using a server-
# generated signature, so files never pass through the Next.js server.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Upload folder inside Cloudinary. Optional (defaults to "chef-harrizona/videos").
CLOUDINARY_FOLDER=""
# Optional cap on video size in bytes (default: 100 MB / 104857600).
CLOUDINARY_MAX_UPLOAD_BYTES=""
